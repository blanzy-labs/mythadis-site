---
import { siteNavItems } from "../../data/site";

interface NavItem {
	label: string;
	href: string;
}

interface Props {
	items?: NavItem[];
	status?: string;
	brandLabel?: string;
	brandSubLabel?: string;
}

const {
	items = siteNavItems,
	status = "Private integrated alpha",
	brandLabel = "Mythadis",
	brandSubLabel,
} = Astro.props;

const normalizePath = (path: string) => {
	const normalized = path.replace(/\/+$/, "");
	return normalized || "/";
};
const currentPath = normalizePath(Astro.url.pathname);
const isCurrentItem = (href: string) => {
	if (href.includes("#") || href.startsWith("http")) return false;
	return normalizePath(href) === currentPath;
};
---

<header class="ds-site-header" aria-label="Primary">
	<a class="ds-brand" href="/">
		<span class="ds-brand-mark" aria-hidden="true">
			<span></span>
			<span></span>
			<span></span>
		</span>
		<span class="ds-brand-text">
			<strong class="ds-brand-label">{brandLabel}</strong>
			{brandSubLabel && <small class="ds-brand-sublabel">{brandSubLabel}</small>}
		</span>
	</a>
	<nav class="ds-site-nav" aria-label="Primary navigation">
		{items.map((item) => (
			<a href={item.href} aria-current={isCurrentItem(item.href) ? "page" : undefined}>
				{item.label}
			</a>
		))}
	</nav>
	<p class="ds-header-status">{status}</p>
</header>

<style>
	.ds-site-header {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: 84px;
		font-family: var(--ds-font-body);
	}

	.ds-brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-weight: 700;
	}

	.ds-brand-mark {
		position: relative;
		display: grid;
		width: 34px;
		height: 34px;
		border: 1px solid var(--ds-line-strong);
		border-radius: var(--ds-radius-sm);
		background: linear-gradient(145deg, rgba(255, 122, 53, 0.14), var(--ds-surface));
		box-shadow: 0 0 22px rgba(255, 122, 53, 0.12), inset 0 0 18px rgba(247, 239, 228, 0.04);
		transform: rotate(45deg);
	}

	.ds-brand-mark span {
		position: absolute;
		background: var(--ds-blue);
		box-shadow: 0 0 12px rgba(255, 122, 53, 0.52);
	}

	.ds-brand-mark span:nth-child(1) {
		inset: 7px auto auto 7px;
		width: 18px;
		height: 2px;
	}

	.ds-brand-mark span:nth-child(2) {
		inset: 7px auto auto 7px;
		width: 2px;
		height: 18px;
	}

	.ds-brand-mark span:nth-child(3) {
		right: 6px;
		bottom: 6px;
		width: 8px;
		height: 8px;
		background: var(--ds-plum);
	}

	.ds-brand-text,
	.ds-brand-label,
	.ds-brand-sublabel {
		display: block;
	}

	.ds-brand-text {
		line-height: 1;
	}

	.ds-brand-label {
		font-size: 1.08rem;
	}

	.ds-brand-sublabel {
		margin-top: 5px;
		color: var(--ds-ink-muted);
		font-family: var(--ds-font-mono);
		font-size: 0.66rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.ds-site-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 28px;
		color: var(--ds-ink-soft);
		font-size: 0.92rem;
	}

	.ds-site-nav a {
		padding-block: 10px;
		border-bottom: 1px solid transparent;
		transition: color 140ms ease, border-color 140ms ease;
	}

	.ds-site-nav a:hover,
	.ds-site-nav a:focus-visible {
		color: var(--ds-ink);
		border-color: var(--ds-blue);
	}

	.ds-site-nav a[aria-current="page"] {
		color: var(--ds-ink);
		border-color: var(--ds-plum);
	}

	.ds-header-status {
		margin: 0;
		padding: 8px 10px;
		border: 1px solid rgba(240, 183, 95, 0.38);
		border-radius: var(--ds-radius-sm);
		color: var(--ds-amber);
		background: rgba(240, 183, 95, 0.08);
		font-family: var(--ds-font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	@media (max-width: 940px) {
		.ds-site-header {
			flex-wrap: wrap;
			row-gap: 12px;
			padding-top: 14px;
		}

		.ds-site-nav {
			order: 3;
			width: 100%;
			justify-content: flex-start;
			gap: 16px;
			overflow-x: auto;
			padding-bottom: 4px;
			color: var(--ds-ink);
			scrollbar-width: none;
		}

		.ds-site-nav::-webkit-scrollbar {
			display: none;
		}
	}

	@media (max-width: 420px) {
		.ds-site-header {
			gap: 14px;
		}

		.ds-site-nav {
			flex-wrap: wrap;
			column-gap: 12px;
			row-gap: 2px;
			overflow-x: visible;
			font-size: 0.8rem;
		}

		.ds-site-nav a {
			padding-block: 6px;
		}

		.ds-header-status {
			font-size: 0.62rem;
		}
	}
</style>
