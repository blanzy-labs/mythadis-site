---
import { brand } from "../config/brand";
import "../styles/case-video.css";
import FinalFrontierLayout from "../layouts/FinalFrontierLayout.astro";
import { films } from "../data/films";
import { publishedFilms, filmHref } from "../lib/films";
const productions = publishedFilms(films);
---
<FinalFrontierLayout title="Watch Original Films — Mythadis">
  <section class="route-heading watch-heading">
    <span class="hero-kicker">{brand.descriptor}</span>
    <h1>ORIGINAL<br /><em>FILMS.</em></h1>
    <p>{productions.length ? "Original short films, unusual worlds and animated stories created through AI tools and human imagination." : "FIRST PRODUCTION IN PROGRESS. Our first original short film will be available here once it is finished and approved for release."}</p>
  </section>
  <section class="watch-programmes" aria-label="Original productions">
    {productions.map(film => <article class="watch-programme">
      <div class="programme-screen" aria-hidden="true">
        {<img src={film.thumbnail ?? "/images/films/off-air.svg"} alt="" loading="lazy" />}
        <span class="programme-placeholder">NOW SHOWING</span>
      </div>
      <div class="programme-copy">
        <small>MYTHADIS ORIGINAL FILM</small>
        <h2><a href={filmHref(film)}>{film.title}</a></h2>
        <p>{film.synopsis}</p>
        <div class="programme-bottom"><a href={filmHref(film)}>WATCH THE FILM →</a></div>
      </div>
    </article>)}
  </section>
</FinalFrontierLayout>
