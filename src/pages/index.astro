---
import { games } from "../data/games";
import BaseLayout from "../layouts/BaseLayout.astro";

const firstRealm = games.find((game) => game.featured);
---

<BaseLayout>
	<main>
		<header>
			<h1>MYTHADIS</h1>
			<p>Games for Worlds Unbound</p>
		</header>
		<section aria-labelledby="introduction">
			<h2 id="introduction">A new world is taking shape.</h2>
			<p>Mythadis is an independent game studio building strange worlds, dangerous places, and games made to be explored.</p>
		</section>
		{firstRealm && (
			<section aria-labelledby="first-realm">
				<h2 id="first-realm">Our first realm:</h2>
				<p>{firstRealm.title}</p>
			</section>
		)}
		<p>More worlds are coming.</p>
	</main>
</BaseLayout>
