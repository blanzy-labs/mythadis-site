---
import Button from "../components/design-system/Button.astro";
import ContentSection from "../components/design-system/ContentSection.astro";
import CurrentStatePanel from "../components/design-system/CurrentStatePanel.astro";
import NetworkMotif from "../components/design-system/NetworkMotif.astro";
import PageHero from "../components/design-system/PageHero.astro";
import SectionLabel from "../components/design-system/SectionLabel.astro";
import StatusLabel from "../components/design-system/StatusLabel.astro";
import SurfacePanel from "../components/design-system/SurfacePanel.astro";
import SystemCard from "../components/design-system/SystemCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
	title="Mythadis Alpha 2 Visual System | Mythadis"
	description="The current Mythadis visual system: warm dark surfaces, cream typography, sunset-orange interaction, lavender selection, and green verification."
	noindex={true}
>
	<PageHero
		label="Mythadis Alpha 2 Visual System"
		title="One product family. A more editorial room."
		description="Mission Control is the visual reference. The website carries its warm darkness, cream typography, sunset-orange interaction, lavender selection, and green verification into a more spacious research and evidence surface."
		primaryHref="#components"
		primaryLabel="Review primitives"
		secondaryHref="/visual-studies/"
		secondaryLabel="View study record"
	/>

	<section class="decision-band" aria-label="Approved decision">
		<p>Mythadis exists to coordinate intelligence&mdash;not just computation.</p>
	</section>

	<ContentSection
		id="principles"
		label="Design principles"
		title="Operational clarity translated into an editorial system."
	>
		<div class="principle-grid">
			<SurfacePanel variant="strong">
				<article class="principle-card">
					<SectionLabel>Identity</SectionLabel>
					<h3>Same universe, different room.</h3>
					<p>
						The website shares Mission Control's palette, type relationship, interaction
						colors, surfaces, and verification language without copying its application layout.
					</p>
				</article>
			</SurfacePanel>
			<SurfacePanel>
				<article class="principle-card">
					<SectionLabel>Use</SectionLabel>
					<h3>Support production pages.</h3>
					<p>
						Components are structured for the homepage, evidence pages, technology pages,
						Annals, Field Reports, Mission Swarms, and collaboration content.
					</p>
				</article>
			</SurfacePanel>
			<SurfacePanel variant="warning">
				<article class="principle-card">
					<SectionLabel>State</SectionLabel>
					<h3>Separate system from launch.</h3>
					<p>
						This is the approved reusable visual foundation. It does not change product
						maturity, public availability, or the authority boundaries stated in site content.
					</p>
				</article>
			</SurfacePanel>
		</div>
	</ContentSection>

	<ContentSection id="foundation" label="Tokens and typography" title="Warm darkness, semantic illumination.">
		<div class="foundation-grid">
			<SurfacePanel>
				<div class="demo-block">
					<SectionLabel>Core palette</SectionLabel>
					<div class="palette-grid" aria-label="Current visual-system colors">
						<div><span class="swatch swatch--app"></span><strong>App</strong><small>#100d0b</small></div>
						<div><span class="swatch swatch--surface"></span><strong>Surface</strong><small>#1b1613</small></div>
						<div><span class="swatch swatch--text"></span><strong>Text</strong><small>#f7efe4</small></div>
						<div><span class="swatch swatch--primary"></span><strong>Primary</strong><small>#ff7a35</small></div>
						<div><span class="swatch swatch--selection"></span><strong>Selection</strong><small>#a865b5</small></div>
						<div><span class="swatch swatch--success"></span><strong>Verified</strong><small>#6fcca2</small></div>
						<div><span class="swatch swatch--warning"></span><strong>Warning</strong><small>#f0b75f</small></div>
						<div><span class="swatch swatch--info"></span><strong>Information</strong><small>#aaa9df</small></div>
					</div>
				</div>
			</SurfacePanel>
			<SurfacePanel variant="strong">
				<div class="demo-block type-demo">
					<SectionLabel>Type relationship</SectionLabel>
					<p class="type-display">Editorial display carries the story.</p>
					<p>Inter keeps explanation, evidence, and interface language direct and readable.</p>
					<code>MONO / STATUS, METADATA, EVIDENCE LABELS</code>
				</div>
			</SurfacePanel>
		</div>
	</ContentSection>

	<ContentSection id="components" label="Reusable primitives" title="Production components aligned with Mission Control Alpha 2.">
		<div class="component-demo">
			<SurfacePanel variant="strong">
				<div class="demo-block">
					<SectionLabel>Buttons</SectionLabel>
					<div class="row">
						<Button href="#components">Primary action</Button>
						<Button href="#components" variant="secondary">Secondary action</Button>
					</div>
				</div>
			</SurfacePanel>

			<SurfacePanel>
				<div class="demo-block">
					<SectionLabel>Status labels</SectionLabel>
					<div class="row">
						<StatusLabel>Prototype</StatusLabel>
						<StatusLabel tone="amber">Private research</StatusLabel>
						<StatusLabel tone="green">Stable token</StatusLabel>
						<StatusLabel tone="plum">Archived alternative</StatusLabel>
					</div>
				</div>
			</SurfacePanel>
		</div>

		<div class="ds-grid ds-grid-3 card-row">
			<SystemCard title="Technology Pages" status="Ready primitive">
				Surfaces for Fluid Swarm Core, agents, Steward Mode, Mission Control, and technical architecture.
			</SystemCard>
			<SystemCard title="Annals & Reports" status="Long-form" tone="green">
				Precise editorial containers for doctrine, research programs, field reports, and proof trails.
			</SystemCard>
			<SystemCard title="Mission Swarms" status="Future page" tone="amber">
				Structured presentation for mission-specific coordination without implying public availability.
			</SystemCard>
		</div>
	</ContentSection>

	<ContentSection id="state" label="Current state" title="Approved language remains constrained.">
		<CurrentStatePanel />
	</ContentSection>

	<ContentSection id="motif" label="Graphic system" title="Network and architecture motifs stay sparse, controlled, and stateful.">
		<div class="motif-layout">
			<NetworkMotif />
			<SurfacePanel>
				<div class="principle-card">
					<SectionLabel>Motif guidance</SectionLabel>
					<h3>Use light as structure, not spectacle.</h3>
					<p>
						Orange identifies active flow, lavender marks selection, green indicates a
						verified state, and warm-neutral lines preserve structure without spectacle.
					</p>
				</div>
			</SurfacePanel>
		</div>
	</ContentSection>
</SiteLayout>

<style>
	.decision-band {
		margin: 0 0 104px;
		padding: 28px 0;
		border-block: 1px solid var(--ds-line);
	}

	.decision-band p {
		width: min(940px, 100%);
		margin: 0;
		font-family: var(--ds-font-display);
		font-size: clamp(1.7rem, 4.4vw, 3.4rem);
		line-height: 1.04;
	}

	.principle-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.principle-card,
	.demo-block {
		padding: 26px;
	}

	.principle-card h3 {
		margin: 0;
		font-size: clamp(1.35rem, 2.2vw, 2rem);
		line-height: 1.04;
	}

	.principle-card p {
		margin: 18px 0 0;
		color: var(--ds-ink-soft);
		line-height: 1.62;
	}

	.component-demo {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px;
	}

	.foundation-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
		gap: 18px;
	}

	.palette-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 12px;
	}

	.palette-grid > div {
		display: grid;
		gap: 7px;
		min-width: 0;
		color: var(--ds-ink-soft);
	}

	.swatch {
		display: block;
		aspect-ratio: 1.7;
		border: 1px solid var(--ds-line-strong);
		border-radius: var(--ds-radius-sm);
	}

	.swatch--app { background: #100d0b; }
	.swatch--surface { background: #1b1613; }
	.swatch--text { background: #f7efe4; }
	.swatch--primary { background: #ff7a35; }
	.swatch--selection { background: #a865b5; }
	.swatch--success { background: #6fcca2; }
	.swatch--warning { background: #f0b75f; }
	.swatch--info { background: #aaa9df; }

	.palette-grid strong {
		color: var(--ds-ink);
		font-size: 0.86rem;
	}

	.palette-grid small,
	.type-demo code {
		color: var(--ds-ink-muted);
		font-family: var(--ds-font-mono);
		font-size: 0.66rem;
	}

	.type-demo {
		display: grid;
		align-content: start;
		gap: 20px;
	}

	.type-demo p {
		margin: 0;
		color: var(--ds-ink-soft);
		line-height: 1.65;
	}

	.type-demo .type-display {
		color: var(--ds-ink);
		font-family: var(--ds-font-display);
		font-size: clamp(2rem, 4vw, 4rem);
		line-height: 0.98;
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		align-items: center;
	}

	.card-row {
		margin-top: 18px;
	}

	.motif-layout {
		display: grid;
		grid-template-columns: minmax(360px, 1.1fr) minmax(0, 0.9fr);
		gap: 18px;
		align-items: stretch;
	}

	@media (max-width: 940px) {
		.principle-grid,
		.component-demo,
		.foundation-grid,
		.motif-layout {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.palette-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 620px) {
		.decision-band {
			margin-bottom: 74px;
		}

		.principle-card,
		.demo-block {
			padding: 20px;
		}
	}
</style>
