---
import FinalFrontierLayout from "../layouts/FinalFrontierLayout.astro";
import EditorialStandardsCopy from "../components/final-frontier/EditorialStandardsCopy.astro";
import "../styles/case-experience.css";
---
<FinalFrontierLayout title="Editorial Standards | Mythadis" description="How Mythadis investigates claims, scores the BS Meter, handles experiments, corrections, evidence and right of reply.">
  <article class="investigation">
    <section class="route-heading"><span class="hero-kicker">MYTHADIS / THE EDITORIAL RECORD</span><h1>Editorial<br /><em>Standards</em></h1></section>
    <div class="investigation-document">
      <aside class="investigation-index"><nav aria-label="Editorial standards sections"><h2>IN THIS FILE</h2><ol><li><a href="#what-mythadis-does">What Mythadis Does</a></li><li><a href="#bs-meter">BS Meter</a></li><li><a href="#experiments-demonstrations">Experiments &amp; Demonstrations</a></li><li><a href="#facts-opinion-commentary">Facts, Opinion &amp; Commentary</a></li><li><a href="#corrections">Corrections</a></li><li><a href="#right-of-reply">Right of Reply</a></li><li><a href="#professional-advice-disclaimer">Professional Advice Disclaimer</a></li><li><a href="#trademarks-third-parties">Trademarks &amp; Third Parties</a></li><li><a href="#updates-to-published-work">Updates to Published Work</a></li></ol></nav></aside>
      <div class="investigation-body"><EditorialStandardsCopy />
        <section aria-labelledby="corrections-evidence"><h2 id="corrections-evidence">Corrections / Evidence</h2>
          <p>Think we got something materially wrong? Send us the exact statement, what you believe is correct, and the evidence supporting it.</p>
          <p>Corrections / Evidence intake opens with the full launch. The contact address is pending.</p>
          <a href="/submit/">Corrections / Evidence — intake status →</a>
        </section>
      </div>
    </div>
  </article>
</FinalFrontierLayout>
