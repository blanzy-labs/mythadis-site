---
import { brand } from "../../config/brand";
import { editorialStandardsHref } from "../../config/editorial";
import { launchReady } from "../../config/launch";
---
{!launchReady && <aside class="fixture-notice" aria-label="Preview content">SOFT-LAUNCH PREVIEW — LABELED FIXTURES ARE MOCK INVESTIGATIONS. IN-PROGRESS CASES HAVE NO FINAL FINDINGS.</aside>}
  <footer class="site-footer" id="about">
    <span>{brand.name} / {brand.series}</span>
    <span>MYTHADIS // A MORE SKEPTICAL TOMORROW</span>
    <p class="footer-editorial">BS Meter ratings are Mythadis editorial opinions based on the evidence available at publication. <a href={editorialStandardsHref}>Editorial Standards</a></p>
  </footer>

<style>
.site-footer{flex-wrap:wrap;gap:12px 24px}
.footer-editorial{flex-basis:100%;margin:0;max-width:85ch;font-weight:400;line-height:1.6}
.footer-editorial a{font-weight:900;text-underline-offset:3px}
</style>
