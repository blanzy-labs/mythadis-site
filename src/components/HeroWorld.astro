---
// Original temporary vector scenery. No reference-image pixels or traced paths.
// A final responsive picture replaces this entire decorative composition in Hero.
const towers = [
	{ x: 1034, y: 302, w: 30, h: 157 }, { x: 1090, y: 244, w: 36, h: 222 },
	{ x: 1142, y: 185, w: 48, h: 295 }, { x: 1202, y: 273, w: 34, h: 192 },
	{ x: 1245, y: 222, w: 40, h: 262 }, { x: 1301, y: 306, w: 30, h: 178 },
	{ x: 1350, y: 270, w: 32, h: 230 },
];
const trees = [{x:1440,y:710,s:1.1},{x:1495,y:760,s:1.6},{x:1040,y:815,s:0.8},{x:1210,y:845,s:0.65},{x:1550,y:845,s:2.2},{x:820,y:860,s:0.7}];
---

<svg class="hero-world" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
	<defs>
		<linearGradient id="world-sky" x2="0.1" y2="1"><stop stop-color="#111a26"/><stop offset=".4" stop-color="#485363"/><stop offset=".68" stop-color="#b1997d"/><stop offset="1" stop-color="#52616a"/></linearGradient>
		<radialGradient id="world-light" cx=".68" cy=".37" r=".47"><stop stop-color="#f1c68e" stop-opacity=".72"/><stop offset=".38" stop-color="#c39876" stop-opacity=".28"/><stop offset="1" stop-color="#b99c83" stop-opacity="0"/></radialGradient>
		<linearGradient id="world-far" x2="0" y2="1"><stop stop-color="#536171"/><stop offset="1" stop-color="#829096"/></linearGradient>
		<linearGradient id="world-rock" x2=".3" y2="1"><stop stop-color="#283640"/><stop offset=".55" stop-color="#1b2a34"/><stop offset="1" stop-color="#0b1720"/></linearGradient>
		<linearGradient id="world-stone" x2="1" y2=".2"><stop stop-color="#121d27"/><stop offset=".6" stop-color="#26323c"/><stop offset="1" stop-color="#46505a"/></linearGradient>
		<linearGradient id="world-fog" x2="0" y2="1"><stop stop-color="#9aa9ac" stop-opacity="0"/><stop offset=".45" stop-color="#9aa9ac" stop-opacity=".26"/><stop offset="1" stop-color="#9aa9ac" stop-opacity="0"/></linearGradient>
		<linearGradient id="world-water" x2="0" y2="1"><stop stop-color="#a49c85" stop-opacity=".3"/><stop offset="1" stop-color="#445d69" stop-opacity=".03"/></linearGradient>
		<linearGradient id="world-ground" x2=".3" y2="1"><stop stop-color="#1b2831"/><stop offset="1" stop-color="#090e14"/></linearGradient>
		<pattern id="world-masonry" width="16" height="18" patternUnits="userSpaceOnUse"><path d="M0 0h16M0 9h16M8 0v9M0 9v9M16 9v9" stroke="#81909a" stroke-opacity=".09" stroke-width=".7"/></pattern>
		<g id="world-pine"><path d="m0 0-8 26h5l-14 25h9l-20 33h23v18h9V84h22L9 51h9L4 26h5Z" fill="#101e25"/><path d="M0 12v82" stroke="#4a5b61" stroke-opacity=".25"/></g>
	</defs>
	<path fill="url(#world-sky)" d="M0 0h1600v1000H0z"/>
	<path fill="url(#world-light)" d="M0 0h1600v1000H0z"/>
	<!-- Broken cloud shelves expose the warm horizon. -->
	<g fill="#263443" opacity=".42"><path d="M0 0h1600v113l-105 20-106-22-94 32-127-14-80 30-117-25-73 32-175-21-124 34-135-44-117 20-168-46L0 123Z"/><path d="m593 233 88-21 87 13 74-15 64 25 64-3 81 25-117 6-100-15-91 11Z"/><path d="m1060 95 61-13 83 11 74-9 105 21 143-5 74 21-156 5-110-13-97 9Z"/></g>
	<!-- Three ranges: each nearer plane gains contrast and detail. -->
	<path d="M0 592 0 370 76 320 113 354 200 256 234 303 290 222 342 291 372 270 438 359 502 308 546 349 600 236 626 281 663 258 719 335 758 322 820 245 855 297 916 278 967 335 1020 250 1074 306 1122 285 1170 337 1240 258 1292 280 1370 208 1430 252 1464 236 1530 315 1600 264V680Z" fill="url(#world-far)" opacity=".66"/>
	<g fill="#b2b3aa" opacity=".16"><path d="m290 222-26 90 40-28 38 7Z"/><path d="m600 236-17 113 43-68Z"/><path d="m820 245-19 95 54-43Z"/><path d="m1370 208-26 121 86-77Z"/></g>
	<path d="M0 728V434l107-74 47 30 62-44 58 71 49-15 66 104 70-32 58 62 65-128 35 39 58-30 34 95 68-18 58 95 50-26 103 26 79-106 54 40 90-75 39 28 64-74 69 31 51-27 91 83 60-52 115 67V782Z" fill="#465969" opacity=".85"/>
	<path d="m498 543 70-119-23 127-17 78-54 83 30-123Z M711 485l-32 139 24 68 33-99Z M1333 432l-54 115 8 76 40-81Z" fill="#819196" opacity=".22"/>
	<path d="M0 479 62 445l43-94 28-14 24-83 31 87 38 16 19 111 61 82 59 21 30 92 48 29 52 165H0Z" fill="url(#world-rock)"/>
	<path d="m157 254-17 155 34 53-6 191 58 166-18-215 18-57-41-91Z M105 351l-20 177 36 96-5 195-43-203 3-99Z M306 550l-25 137 51 132-19-163Z" fill="#70828b" opacity=".19"/>
	<!-- Small, remote ruins establish scale across the valley. -->
	<g fill="#3a4c5b"><path d="M656 484v-99h7v-22h5v-26l5-18 6 18v26h6v32h8v85h17v-50h7v-25h6v25h7v57Z"/><path d="M856 507v-81h7v-21h5v-33l6-22 5 22v32h7v32h8v68Z"/><path d="m643 480 26-10 23 9 22-5 33 37 20 86-47 47-92-37 15-68Z M849 506l26-6 26 9 21 61-45 54-48-24Z"/></g>
	<path d="M312 556c245-81 354 24 548-10s472-53 740-22v114c-301-21-512 14-752 9S476 659 312 674Z" fill="url(#world-fog)"/>
	<!-- Fortress rock, with a vertical, fractured face. -->
	<path d="m930 570 59-25 33-50 54-15 49-42 85 18 48-8 30 32 87-10 49 45 20 66 43 52 20 167 59 89-415 56-110-66 26-69-53-81Z" fill="url(#world-rock)"/>
	<g fill="#64737d" opacity=".25"><path d="m1076 480-21 149 31 57-23 132 40-103-8-99 30-178Z"/><path d="m1210 456-34 139 23 57-27 177 62-170-15-49 39-162Z"/><path d="m1375 470-31 101 17 110-18 96 47-140-10-58 34-64Z"/><path d="m1022 495-15 83 29 40-30 142 51-131-26-57 45-92Z"/></g>
	<g fill="#0e1b24" opacity=".8"><path d="m1125 438-17 194 27 66-37 167 65-128-7-102 37-171Z"/><path d="m1288 480-35 140 34 90-15 155 50-133-16-92 33-154Z"/></g>
	<!-- An original stepped citadel, narrow spires, buttresses, and lit slits. -->
	<g fill="url(#world-stone)" stroke="#9c927e" stroke-opacity=".26" stroke-width="1">
		<path d="M1019 508v-64h35v-42h24v22h35v-67h54v28h42v-21h36v43h54v-25h23v47h54v-23h25v37h22v91Z"/>
		{towers.map(({ x, y, w, h }) => <g>
			<path d={`M${x} ${y+h}V${y+40}h-5l${w/2+5}-40 ${w/2+5} 40h-5v${h-40}Z`} />
			<path d={`M${x+w/2} ${y-25}v29M${x-4} ${y+43}h${w+8}M${x+4} ${y+60}v${h-65}M${x+w-5} ${y+58}v${h-63}`} fill="none" />
			<path d={`M${x} ${y+40}h${w}v${h-40}h-${w}Z`} fill="url(#world-masonry)" stroke="none" />
			{[.42,.64,.82].map((fraction) => <path d={`M${x+w*.56} ${y+h*fraction}v9`} stroke="#d5a46c" stroke-opacity=".75" stroke-width="2" />)}
		</g>)}
		<path d="m1126 488 10-98 7-7 5 95m50 12 5-105 8 11 7 101m57 11 7-68 8-9 7 83" fill="#192832"/>
		<path d="M1161 516v-38q14-31 28 0v38Z" fill="#0b141c"/>
		<path d="M1173 482v22" stroke="#daa46b" stroke-width="3" stroke-opacity=".8"/>
		<path d="m1008 509 105 1 20 15 90-4 34 10 89-7 70 22" fill="none" stroke="#8a8d86" stroke-opacity=".5" stroke-width="3"/>
	</g>
	<!-- A long bridge vanishes into the mist; the broken span stays open. -->
	<g fill="#2b3d49" stroke="#8b9799" stroke-opacity=".22">
		<path d="m717 638 219-70 13 11-231 78Z"/>
		<path d="m741 649 12-4 7 132-23 14Z m65-22 14-5 7 117-23 23Z m68-22 15-5 15 119-26 20Z m46-13 13-5 20 100-28 15Z"/>
		<path d="m748 649q28-57 62-20m8-7q28-55 61-18m5-3q15-37 40-13" fill="none" stroke="#2b3d49" stroke-width="15"/>
		<path d="m654 654 38-9 8 15-50 12Z"/>
	</g>
	<path d="M367 726c182-76 307-55 418-30 141 32 359-79 655-8l160 49v121c-211-65-404-35-581-3-241 43-417-30-652-8Z" fill="url(#world-fog)"/>
	<path d="M877 755c-20 33-115 52-131 69-22 24 59 28 50 50s-111 52-151 95h205c47-39 41-71-5-91-42-19 37-55 47-67 18-22 8-41-15-56Z" fill="url(#world-water)"/>
	<!-- Near ridges and forest are darker than the environment behind them. -->
	<path d="m0 809 170-51 124 37 96-22 97 76 98-6 84 44 83-11 79 63 65 61H0Z" fill="url(#world-ground)"/>
	<path d="m900 1000 36-80 33-36 6-18 48-10 29 13 38 48 43-48 68 10 44-69 66-19 43-51 66 6 55-82 74-16 51 22v330Z" fill="url(#world-ground)"/>
	{trees.map(({x,y,s}) => <use href="#world-pine" transform={`translate(${x} ${y}) scale(${s})`} />)}
	<g fill="none" stroke="#687b85" stroke-opacity=".27"><path d="m24 824 112-37 75 22 81-2 72 19-120 15-67-18-88 25m220-40 58 30 33 57 89 21m-131-58 63-7 72 57 62-4m559 22 64-47 39 14 47-47 81-14m-128 45 10 55 32 28m-114-5 63-31 53 12"/></g>
	<!-- A tiny traveler on the near ridge, subordinate to the world. -->
	<g fill="#10161d" stroke="#63717a" stroke-width="1" stroke-opacity=".35"><path d="m989 838-3-19 4-12 7-4 7 5 3 13-4 16 16 29-31 6-10-7Z"/><path d="m991 864-3 22h5l5-21 4 22h5l-2-24m-17-35-9 17-6 1 9-23"/><path d="m977 833-8 54" fill="none" stroke="#6b797d" stroke-opacity=".7" stroke-width="2"/></g>
</svg>

<style>
	.hero-world { display: block; width: 100%; height: 100%; }
	@media (max-width: 63.999rem) { .hero-world { width: 180%; max-width: none; transform: translateX(-40%); } }
</style>
