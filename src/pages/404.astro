---
import Button from "../components/design-system/Button.astro";
import SectionLabel from "../components/design-system/SectionLabel.astro";
import SiteFooter from "../components/design-system/SiteFooter.astro";
import SiteHeader from "../components/design-system/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteNavItems } from "../data/site";
---

<BaseLayout
	title="Page Not Found | Mythadis"
	description="The requested Mythadis page could not be found."
	noindex={true}
>
	<div class="ds-shell">
		<SiteHeader
			items={siteNavItems}
			brandLabel="Mythadis"
			brandSubLabel="Swarm"
			status="Archive gap"
		/>
		<main id="main-content" class="not-found-page" aria-labelledby="page-title">
			<SectionLabel>404 / Record not found</SectionLabel>
			<h1 id="page-title">This page is outside the public archive.</h1>
			<p>
				The address may have changed, or the record may not be public. Return to the
				Mythadis overview or review the canonical Current State.
			</p>
			<div class="not-found-actions">
				<Button href="/">Return home</Button>
				<Button href="/current-state/" variant="secondary">View Current State</Button>
			</div>
		</main>
		<SiteFooter />
	</div>
</BaseLayout>

<style>
	.not-found-page {
		display: grid;
		align-content: center;
		min-height: calc(100svh - 84px);
		padding-block: 72px;
	}

	.not-found-page h1 {
		max-width: 14ch;
		margin: 20px 0 0;
		font-size: clamp(3.2rem, 8vw, 7.4rem);
		line-height: 0.92;
	}

	.not-found-page p {
		max-width: 560px;
		margin: 24px 0 34px;
		color: var(--ds-ink-soft);
		font-size: 1.08rem;
		line-height: 1.6;
	}

	.not-found-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	@media (max-width: 620px) {
		.not-found-page {
			min-height: auto;
			padding-block: 72px 96px;
		}

		.not-found-actions {
			display: grid;
		}
	}
</style>
