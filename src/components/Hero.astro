---
import ButtonLink from "./ButtonLink.astro";
import MythadisMark from "./MythadisMark.astro";
import HeroWorld from "./HeroWorld.astro";

interface HeroArtwork {
	// Put mobile sources before desktop sources; all paths must be local.
	sources?: Array<{
		srcset: string;
		type: "image/avif" | "image/webp" | "image/jpeg";
		media?: string;
	}>;
	src: string;
	width: number;
	height: number;
	position?: string;
	mobilePosition?: string;
}
interface Props { artwork?: HeroArtwork; }
const { artwork } = Astro.props;
const artworkPosition = artwork ? `--hero-position: ${artwork.position ?? "68% 45%"}; --hero-mobile-position: ${artwork.mobilePosition ?? "72% 45%"};` : undefined;
---

<section class="hero" aria-labelledby="hero-title" style={artworkPosition} data-artwork={artwork ? "supplied" : "placeholder"}>
	<div class="hero__artwork" aria-hidden="true">
		{artwork ? <picture>
			{artwork.sources?.map(({ srcset, type, media }) => <source srcset={srcset} type={type} media={media} />)}
			<img src={artwork.src} width={artwork.width} height={artwork.height} alt="" loading="eager" fetchpriority="high" decoding="async" />
		</picture> : <HeroWorld />}
	</div>
	<div class="hero__shade" aria-hidden="true"></div>
	<div class="hero__layout container container--wide">
		<div class="hero__content">
			<p class="hero__label eyebrow"><MythadisMark size={16} /><span>Independent Game Studio</span></p>
			<h1 id="hero-title"><span>Strange Worlds.</span><span><em>Bolder Games.</em></span></h1>
			<p class="hero__description">Mythadis is an independent game studio building dangerous places, memorable worlds, and games made to be explored.</p>
			<div class="hero__actions">
				<ButtonLink href="#games" variant="realm">Explore Our Worlds</ButtonLink>
				<ButtonLink href="#studio" variant="text">Meet Mythadis</ButtonLink>
			</div>
		</div>
	</div>
	<div class="hero__waymark" aria-hidden="true"><span></span><MythadisMark size={24} /><span></span></div>
</section>

<style>
	.hero {
		--world-height: clamp(25rem, 100vw, 40rem);
		position: relative;
		isolation: isolate;
		background: var(--color-void);
	}
	.hero__artwork, .hero__shade { position: absolute; inset: 0 0 auto; height: var(--world-height); pointer-events: none; }
	.hero__artwork { overflow: hidden; background: var(--color-slate); }
	.hero__artwork picture { display: block; width: 100%; height: 100%; }
	.hero__artwork img { width: 100%; height: 100%; object-fit: cover; object-position: var(--hero-mobile-position, 72% 45%); }
	.hero__shade {
		background: linear-gradient(180deg, rgb(9 11 14 / 15%), transparent 42%, rgb(9 11 14 / 12%) 66%, var(--color-void)), linear-gradient(90deg, rgb(9 11 14 / 22%), transparent 35%, transparent 80%, rgb(9 11 14 / 22%));
	}
	.hero__layout {
		position: relative;
		z-index: var(--z-overlay);
		padding-top: calc(var(--world-height) - var(--space-8));
		padding-bottom: var(--space-12);
	}
	.hero__content { display: grid; gap: var(--space-4); width: 100%; max-width: 38rem; }
	.hero__label { display: flex; align-items: center; gap: var(--space-2); color: var(--color-gold); font-size: 0.75rem; letter-spacing: 0.12em; }
	.hero__label::after { content: ""; width: var(--space-8); height: var(--line-thin); background: var(--color-bronze); }
	.hero h1 { font-size: clamp(3rem, 4.5vw, 5.5rem); line-height: 1.04; text-shadow: 0 2px 30px rgb(9 11 14 / 28%); }
	.hero h1 span { display: block; }
	.hero h1 em { font-weight: 500; }
	.hero__description { max-width: 31rem; font-size: var(--text-body); line-height: 1.7; color: var(--color-bone); }
	.hero__actions { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-2); margin-top: var(--space-2); }
	.hero__actions :global(.button-link--text) { align-self: flex-start; font-size: 0.75rem; }
	.hero__waymark { display: none; }
	@media (min-width: 40rem) {
		.hero__content { max-width: 38rem; }
		.hero__actions { flex-direction: row; align-items: center; gap: var(--space-6); }
	}
	@media (min-width: 64rem) {
		.hero__artwork, .hero__shade { inset: 0; height: 100%; }
		.hero__artwork img { object-position: var(--hero-position, 68% 45%); }
		.hero__shade {
			background: linear-gradient(90deg, rgb(9 11 14 / 84%), rgb(9 11 14 / 62%) 30%, rgb(9 11 14 / 10%) 54%, transparent 76%, rgb(9 11 14 / 10%)), linear-gradient(0deg, var(--color-void), rgb(9 11 14 / 10%) 16%, transparent 38%, transparent 84%, rgb(9 11 14 / 25%));
		}
		.hero__layout { display: flex; align-items: center; min-height: max(94svh, 50rem); padding-top: calc(var(--space-32) + var(--space-16)); padding-bottom: var(--space-24); }
		.hero__content { width: 44%; gap: var(--space-6); }
		.hero__description { font-size: clamp(1rem, 1.1vw, 1.125rem); text-shadow: 0 1px 12px var(--color-void); }
		.hero__actions { gap: var(--space-6); flex-wrap: wrap; }
		.hero__waymark { position: absolute; right: var(--page-gutter); bottom: var(--space-8); display: flex; align-items: center; gap: var(--space-3); color: var(--color-gold); opacity: 0.65; }
		.hero__waymark span { width: var(--space-8); height: var(--line-thin); background: currentColor; }
	}
</style>
