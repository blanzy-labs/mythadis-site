---
import BrandLockup from "./BrandLockup.astro";
const navigation = [
  { label: "Home", href: "/#home" },
  { label: "Games", href: "/#games" },
  { label: "About", href: "/#about" },
];
---
<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="/#home" aria-label="MYTHADIS — Games for Worlds Unbound, home"><BrandLockup variant="sigil" /></a>
    <nav class="desktop-navigation" aria-label="Main navigation">
      <ul>{navigation.map(({label,href}) => <li><a class="navigation-link" href={href}>{label}</a></li>)}</ul>
    </nav>
    <details class="mobile-navigation" data-mobile-navigation>
      <summary aria-controls="mobile-navigation-panel">
        <span class="menu-label-closed">Menu</span><span class="menu-label-open">Close</span>
        <svg class="menu-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path class="menu-icon__top" d="M3 6h14"/><path class="menu-icon__bottom" d="M3 14h14"/></svg>
      </summary>
      <nav class="mobile-navigation__panel" id="mobile-navigation-panel" aria-label="Mobile navigation">
        <ul>{navigation.map(({label,href}) => <li><a class="navigation-link" href={href}>{label}<span aria-hidden="true">↗</span></a></li>)}</ul>
      </nav>
    </details>
  </div>
</header>

<script>
	// A native disclosure works without JavaScript. These additions keep its
	// explicit ARIA state in sync and close it after navigation or Escape.
	document.querySelectorAll<HTMLDetailsElement>("[data-mobile-navigation]").forEach((menu) => {
		const toggle = menu.querySelector<HTMLElement>("summary")!;
		const sync = () => toggle.setAttribute("aria-expanded", String(menu.open));
		const close = () => { menu.open = false; sync(); };
		sync();
		menu.addEventListener("toggle", sync);
		menu.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && menu.open) {
				event.preventDefault();
				close();
				toggle.focus();
			}
		});
		menu.addEventListener("click", (event) => {
			if ((event.target as Element).closest("a[href]")) close();
		});
		menu.addEventListener("focusout", (event) => {
			if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) close();
		});
		document.addEventListener("click", (event) => {
			if (event.target instanceof Node && !menu.contains(event.target)) close();
		});
		matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
			if (event.matches && menu.open) {
				const restoreFocus = menu.contains(document.activeElement);
				close();
				if (restoreFocus) menu.closest("header")?.querySelector<HTMLAnchorElement>(".site-header__brand")?.focus();
			}
		});
	});
</script>

<style>
  .site-header { position: relative; z-index: var(--z-focus); }
  .site-header__inner { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; padding-block:1.5rem; }
  .site-header__brand { text-decoration:none; flex-shrink:0; max-width:calc(100% - 6rem); }
  .desktop-navigation { display:none; }
  ul { list-style:none; margin:0; padding:0; }
  .navigation-link { display:flex; align-items:center; min-height:3rem; text-decoration:none; font-size:.875rem; color:var(--color-bone); text-underline-offset:.5em; }
  .navigation-link:hover { color:var(--color-parchment); text-decoration:underline; }
  .mobile-navigation summary { display:flex; align-items:center; gap:.75rem; min-height:3rem; cursor:pointer; list-style:none; font-size:.875rem; }
  .mobile-navigation summary::-webkit-details-marker { display:none; }
  .menu-label-open { display:none; }
  .mobile-navigation[open] .menu-label-open { display:inline; }
  .mobile-navigation[open] .menu-label-closed { display:none; }
  .mobile-navigation[open] .menu-icon__top { transform:translateY(4px) rotate(45deg); transform-origin:10px 6px; }
  .mobile-navigation[open] .menu-icon__bottom { transform:translateY(-4px) rotate(-45deg); transform-origin:10px 14px; }
  .mobile-navigation__panel { position:absolute; inset:100% 0 auto; padding:1rem var(--page-gutter) 2rem; background:var(--color-obsidian); border-bottom:1px solid var(--border-subtle); }
  .mobile-navigation__panel a { justify-content:space-between; padding-block:1rem; border-top:1px solid var(--border-subtle); font-size:1.125rem; }
  @media(min-width:64rem) {
    .site-header__inner { padding-block:2rem; }
    .desktop-navigation, .desktop-navigation ul { display:flex; gap:3rem; }
    .mobile-navigation { display:none; }
  }
</style>
