---
import Button from "../components/design-system/Button.astro";
import NetworkMotif from "../components/design-system/NetworkMotif.astro";
import SectionLabel from "../components/design-system/SectionLabel.astro";
import SiteFooter from "../components/design-system/SiteFooter.astro";
import SiteHeader from "../components/design-system/SiteHeader.astro";
import StatusLabel from "../components/design-system/StatusLabel.astro";
import SurfacePanel from "../components/design-system/SurfacePanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { statusSummary } from "../data/current-state";
import {
	blanzyLabsGitHubUrl,
	linkedInUrl,
	siteNavItems,
} from "../data/site";

const fragmentationNodes = [
	"Knowledge",
	"Institutions",
	"AI",
	"People",
	"Machines",
	"Evidence",
];

const flowSteps = [
	{
		name: "Describe",
		description: "Explain the investigation or outcome in ordinary language.",
	},
	{
		name: "Review",
		description: "Review one human-readable governed mission plan and approve it.",
	},
	{
		name: "Analyze",
		description: "Use approved evidence and eligible execution capabilities within mission boundaries.",
	},
	{
		name: "Verify",
		description: "Check results, evidence, and lineage before they are presented.",
	},
	{
		name: "Continue",
		description: "Ask a natural-language follow-up without rebuilding the mission manually.",
	},
];

const missionSwarms = [
	"Longevity",
	"Pollution",
	"Climate",
	"Public science",
	"Knowledge preservation",
];

const collaborators = [
	"Engineers",
	"Researchers",
	"Institutions",
	"Advisors",
	"Early testers",
];

const statusModel = [
	{
		label: "Working today",
		tone: "green",
		items: "A private integrated alpha has completed a governed analytical mission and follow-up end to end.",
	},
	{
		label: "In active development",
		tone: "blue",
		items: "Golden Mission stability, persistent workspaces, richer analysis, larger workloads, and operational resilience.",
	},
	{
		label: "Research direction",
		tone: "plum",
		items: "Public Agent distribution, Mission Swarms, and humanity-scale applications.",
	},
] as const;

const systemComponents = [
	{
		name: "Operator",
		status: "Interpretation layer",
		tone: "blue",
		body: "Translates ordinary-language intent into structured mission understanding and analytical strategy. Operator proposes; it is not the durable execution or approval authority.",
	},
	{
		name: "Mission Control",
		status: "Authoritative operating layer",
		tone: "green",
		body: "Maintains durable mission state, governs human decisions, selects approved capabilities, coordinates evidence and execution, and preserves lineage and decision records.",
	},
	{
		name: "MDAP",
		status: "Governed evidence layer",
		tone: "blue",
		body: "Provides governed data discovery, acquisition, verification, catalogue, and provenance capabilities.",
	},
	{
		name: "Analytics & Execution",
		status: "Governed capability layer",
		tone: "blue",
		body: "Routes approved analytical work to eligible execution engines. Engines are capabilities used by Mythadis, not the product itself.",
	},
	{
		name: "Swarm",
		status: "Strategic substrate",
		tone: "amber",
		body: "Provides a distributed compute, storage, and collective-intelligence option. It is not a mandatory stage of every mission and is not a public production network.",
	},
] as const;

const missionControlTerms = [
	{
		name: "Signals",
		body: "observations or events relevant to a mission.",
	},
	{
		name: "Relics",
		body: "durable evidence artifacts or validated outputs.",
	},
	{
		name: "Annals",
		body: "the persistent record of mission history.",
	},
];
---

<BaseLayout
	title="Mythadis | Coordinate Intelligence"
	description="Mythadis is a governed mission-intelligence platform for human + AI coordination, governed evidence, analytical execution, and verified analysis."
>
	<div class="ds-shell">
		<SiteHeader
			items={siteNavItems}
			brandLabel="Mythadis"
			brandSubLabel="Swarm"
			status="Private Integrated Alpha"
		/>

		<main id="main-content">
			<section class="home-hero" id="vision" aria-labelledby="page-title">
				<div class="home-hero__copy">
					<SectionLabel>Mission question</SectionLabel>
					<h1 id="page-title">
						How do we{" "}<span class="hero-phrase hero-phrase--primary">organize intelligence</span>&mdash;<span class="hero-phrase hero-phrase--selection">human and artificial</span>&mdash;<span class="hero-phrase">so that together</span>{" "}
						we can{" "}<span class="hero-phrase hero-phrase--primary">solve problems</span>{" "}that <span>neither could solve alone</span>?
					</h1>
					<p class="hero-answer">A Coordination Fabric for Collective Intelligence.</p>
					<div class="hero-product">
						<h2>From question to verified analysis.</h2>
						<p>
							Describe an investigation in ordinary language. Mythadis helps define the mission,
							governs evidence and approved execution, verifies results with lineage, and keeps
							the human in authority as follow-up questions continue the work.
						</p>
					</div>
					<div class="hero-actions" aria-label="Primary page actions">
						<Button href="#problem">Explore the Vision</Button>
						<Button href="/current-state/" variant="secondary">Current State</Button>
						<Button href="#collaborate" variant="secondary">Collaborate</Button>
					</div>
				</div>
				<div class="home-hero__visual">
					<NetworkMotif />
				</div>
			</section>

			<section class="signal-statement" aria-label="Core system statement">
				<p>Many minds.</p>
				<p>Many machines.</p>
				<p>Many models.</p>
				<p>One proof-first fabric.</p>
			</section>

			<section class="problem-section" id="problem" aria-labelledby="problem-title">
				<div class="section-heading">
					<SectionLabel>Humanity's problem</SectionLabel>
					<h2 id="problem-title">The intelligence we need is fragmented.</h2>
				</div>
				<div class="problem-layout">
					<div class="fragment-map" aria-label="Fragmented systems diagram">
						{fragmentationNodes.map((node, index) => (
							<div class={`fragment-node fragment-node--${index + 1}`}>
								<span>{node}</span>
							</div>
						))}
						<div class="fragment-core">
							<span>Disconnected proof</span>
						</div>
					</div>
					<div class="problem-copy">
						<p>
							Knowledge, institutions, AI, people, and machines are learning in isolation.
						</p>
						<p>
							Mythadis asks what becomes possible when intelligence can discover, coordinate,
							verify, and remember together.
						</p>
					</div>
				</div>
			</section>

			<section class="swarm-section" id="swarm" aria-labelledby="swarm-title">
				<div class="section-heading">
					<SectionLabel>What Mythadis Is</SectionLabel>
					<h2 id="swarm-title">A governed mission-intelligence platform.</h2>
				</div>
				<div class="swarm-layout">
					<div class="swarm-copy">
						<p class="principle-line">Unity without centralization.</p>
						<p>
							Mythadis is a working private integrated alpha for coordinating people, models,
							evidence, approved analytical capabilities, and durable mission decisions.
						</p>
						<p>
							The goal is governed coordination, not unrestricted autonomy. Mission Control
							preserves the human authority boundary while work becomes discoverable, bounded,
							testable, and remembered.
						</p>
					</div>
					<div class="status-model" aria-label="Mythadis status model">
						{statusModel.map((item) => (
							<article>
								<StatusLabel tone={item.tone}>{item.label}</StatusLabel>
								<p>{item.items}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="flow-section" aria-labelledby="flow-title">
				<div class="section-heading">
					<SectionLabel>The Mission Experience</SectionLabel>
					<h2 id="flow-title">A simple path from intent to continued investigation.</h2>
				</div>
				<ol class="flow-list" aria-label="Five-step Mythadis mission experience">
					{flowSteps.map((step) => (
						<li>
							<span>{step.name}</span>
							<p>{step.description}</p>
						</li>
					))}
				</ol>
			</section>

			<section class="components-section" aria-labelledby="components-title">
				<div class="section-heading">
					<SectionLabel>System components</SectionLabel>
					<h2 id="components-title">Reasoning, authority, evidence, execution, and distributed capacity.</h2>
				</div>
				<div class="components-grid">
					<div class="component-list">
						{systemComponents.map((component) => (
							<article>
								<StatusLabel tone={component.tone}>{component.status}</StatusLabel>
								<h3>{component.name}</h3>
								<p>{component.body}</p>
							</article>
						))}
					</div>
					<div class="control-panel" aria-label="Mission Control terminology">
						<div>
							<span>Mission</span>
							<p>a defined problem, scope, and proof objective.</p>
						</div>
						{missionControlTerms.map((term) => (
							<div>
								<span>{term.name}</span>
								<p>{term.body}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<section class="future-proof-section" aria-labelledby="future-proof-title">
				<div class="section-heading">
					<SectionLabel>Proof and future direction</SectionLabel>
					<h2 id="future-proof-title">A complete mission now works end to end.</h2>
				</div>
				<div class="future-proof-layout">
					<div class="evidence-lines">
						<p>A founder validation began with a plain-language objective, moved through mission interpretation and one approved plan, and selected governed evidence and execution automatically.</p>
						<p>The mission returned a verified result with lineage, recorded human acceptance, and continued through a natural-language analytical follow-up.</p>
						<p>The Alpha 2 follow-up was routed automatically through a real Trino backend and returned another verified result. Trino is evidence of orchestration, not Mythadis itself.</p>
					</div>
					<div class="mission-card-grid" aria-label="Research direction mission areas">
						{missionSwarms.map((mission) => (
							<article>
								<StatusLabel tone="plum">Research direction</StatusLabel>
								<h3>{mission}</h3>
							</article>
						))}
					</div>
				</div>
				<div class="future-proof-note">
					<p>Vision is not enough.</p>
					<p>Mission Swarms point toward domains where coordinated intelligence may matter, not demonstrated public outcomes.</p>
				</div>
			</section>

			<section class="current-state-section" id="current-state" aria-labelledby="state-title">
				<div class="section-heading">
					<SectionLabel>Current State</SectionLabel>
					<h2 id="state-title">The complete status lives on Current State.</h2>
				</div>
				<SurfacePanel variant="warning">
					<div class="state-summary">
						<ul aria-label="Homepage current state summary">
							{statusSummary.map((item) => <li>{item}</li>)}
						</ul>
						<p>
							Mythadis is a private integrated alpha with an end-to-end demonstrated mission
							path. It is not production-ready or a public production network.
						</p>
						<Button href="/current-state/">View the complete current state</Button>
					</div>
				</SurfacePanel>
			</section>

			<section class="collaborate-section" id="collaborate" aria-labelledby="collaborate-title">
				<SurfacePanel variant="strong">
					<div class="collaborate-card">
						<div>
							<SectionLabel>Collaborate</SectionLabel>
							<h2 id="collaborate-title">Help shape the first credible swarm.</h2>
							<p>
								Early conversations are most useful with people who can pressure-test the
								architecture, the proof discipline, and the mission model.
							</p>
						</div>
						<div class="collaborator-list" aria-label="Collaboration audiences">
							{collaborators.map((collaborator) => <span>{collaborator}</span>)}
						</div>
						<div class="contact-panel">
							<p class="contact-label">Engagement paths</p>
							<a href={linkedInUrl} rel="noreferrer">
								Start a conversation
							</a>
							<a href={blanzyLabsGitHubUrl} rel="noreferrer">
								Explore Blanzy Labs on GitHub
							</a>
							<p>
								LinkedIn is the current direct conversation path. GitHub remains the public
								evidence path for technical work while Mythadis remains a private integrated alpha.
							</p>
						</div>
					</div>
				</SurfacePanel>
			</section>
		</main>

		<SiteFooter />
	</div>
</BaseLayout>

<style>
	h1,
	h2,
	h3,
	p {
		text-wrap: pretty;
	}

	h1,
	h2,
	h3 {
		margin: 0;
		font-family: var(--ds-font-display);
		letter-spacing: 0;
	}

	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
		gap: clamp(24px, 3.4vw, 48px);
		align-items: center;
		min-height: min(720px, calc(100svh - 84px));
		padding: clamp(16px, 2.6svh, 30px) 0 clamp(32px, 4.4svh, 58px);
	}

	.home-hero__copy {
		max-width: 800px;
		position: relative;
		z-index: 1;
	}

	.home-hero h1 {
		max-width: 22.5ch;
		margin-top: 10px;
		font-size: clamp(2.7rem, 3.95vw, 3.8rem);
		line-height: 0.98;
		text-wrap: balance;
	}

	@media (min-width: 681px) {
		.home-hero h1 .hero-phrase {
			white-space: nowrap;
		}
	}

	.hero-phrase--primary {
		color: var(--ds-primary-hover);
	}

	.hero-phrase--selection {
		color: var(--ds-plum-text);
	}

	.home-hero__visual {
		width: min(100%, 520px, 50svh);
		justify-self: end;
		align-self: center;
	}

	.hero-answer {
		max-width: 620px;
		margin: clamp(16px, 2.3svh, 24px) 0 0;
		color: var(--ds-ink);
		font-family: var(--ds-font-display);
		font-size: clamp(1.16rem, 1.48vw, 1.58rem);
		font-weight: 700;
		line-height: 1.15;
	}

	.hero-product {
		max-width: 680px;
		margin-top: 20px;
		padding-left: 18px;
		border-left: 1px solid var(--ds-blue);
	}

	.hero-product h2 {
		font-size: clamp(1.35rem, 2.1vw, 2rem);
		line-height: 1.08;
	}

	.hero-product p {
		margin: 10px 0 0;
		color: var(--ds-ink-soft);
		font-size: 1rem;
		line-height: 1.62;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: clamp(18px, 2.6svh, 26px);
	}

	.signal-statement {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0;
		margin: 0 0 118px;
		border-block: 1px solid var(--ds-line);
	}

	.home-hero + .signal-statement {
		margin-top: 8px;
	}

	.signal-statement p {
		min-height: 148px;
		margin: 0;
		padding: 22px;
		border-right: 1px solid var(--ds-line);
		color: var(--ds-ink);
		font-family: var(--ds-font-display);
		font-size: clamp(1.45rem, 2.6vw, 2.7rem);
		font-weight: 700;
		line-height: 1;
	}

	.signal-statement p:last-child {
		border-right: 0;
		color: var(--ds-mint);
	}

	.problem-section,
	.swarm-section,
	.flow-section,
	.components-section,
	.future-proof-section,
	.agent-section,
	.mission-control-section,
	.mission-swarms-section,
	.current-state-section,
	.collaborate-section {
		padding: 0 0 118px;
	}

	.section-heading {
		max-width: 900px;
		margin-bottom: 30px;
	}

	.section-heading h2,
	.components-section h2,
	.agent-section h2,
	.control-copy h2,
	.collaborate-card h2 {
		font-size: clamp(2.2rem, 4.6vw, 4.55rem);
		line-height: 0.98;
	}

	.problem-layout,
	.swarm-layout,
	.components-grid,
	.future-proof-layout,
	.agent-section,
	.control-grid,
	.state-panel,
	.collaborate-card {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(320px, 1fr);
		gap: 32px;
		align-items: start;
	}

	.fragment-map {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12px;
		min-height: 390px;
		padding: 22px;
		border: 1px solid var(--ds-line-strong);
		border-radius: var(--ds-radius-md);
		background:
			linear-gradient(135deg, rgba(247, 239, 228, 0.06), transparent 28%),
			radial-gradient(circle at 50% 50%, rgba(255, 122, 53, 0.18), transparent 13rem),
			rgba(16, 13, 11, 0.46);
		overflow: hidden;
	}

	.fragment-map::before,
	.fragment-map::after {
		position: absolute;
		inset: 50% 10%;
		height: 1px;
		content: "";
		background: linear-gradient(90deg, transparent, rgba(255, 122, 53, 0.48), transparent);
	}

	.fragment-map::after {
		transform: rotate(90deg);
	}

	.fragment-node,
	.fragment-core,
	.collaborator-list span {
		border: 1px solid var(--ds-line);
		border-radius: var(--ds-radius-sm);
		background: rgba(27, 22, 19, 0.74);
	}

	.fragment-node {
		position: relative;
		z-index: 1;
		display: grid;
		align-items: center;
		min-height: 98px;
		padding: 14px;
		color: var(--ds-ink-soft);
		font-family: var(--ds-font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.fragment-node--2,
	.fragment-node--5 {
		transform: translateY(34px);
	}

	.fragment-core {
		position: absolute;
		z-index: 2;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: min(52%, 250px);
		min-height: 86px;
		padding: 16px;
		color: var(--ds-amber);
		font-family: var(--ds-font-display);
		font-weight: 700;
		text-align: center;
		transform: translate(-50%, -50%);
		box-shadow: 0 0 36px rgba(240, 183, 95, 0.12);
	}

	.problem-copy {
		display: grid;
		gap: 18px;
	}

	.problem-copy p,
	.swarm-copy p,
	.status-model p,
	.component-list p,
	.control-panel p,
	.future-proof-note p,
	.state-summary p,
	.swarm-grid p,
	.agent-panel p,
	.control-copy p,
	.state-copy p,
	.collaborate-card p,
	.contact-panel p {
		margin: 0;
		color: var(--ds-ink-soft);
		font-size: 1rem;
		line-height: 1.68;
	}

	.problem-copy p:first-child {
		color: var(--ds-ink);
		font-family: var(--ds-font-display);
		font-size: clamp(1.55rem, 3vw, 2.45rem);
		font-weight: 700;
		line-height: 1.08;
	}

	.unity-section {
		display: grid;
		align-content: center;
		min-height: 74svh;
		padding: 76px 0 132px;
	}

	.unity-section h2 {
		max-width: 920px;
		font-size: clamp(4.4rem, 11vw, 10.8rem);
		line-height: 0.86;
	}

	.unity-section p {
		max-width: 620px;
		margin: 30px 0 0 auto;
		color: var(--ds-ink-soft);
		font-size: clamp(1.05rem, 1.8vw, 1.28rem);
		line-height: 1.65;
	}

	.swarm-layout {
		align-items: stretch;
	}

	.swarm-copy {
		display: grid;
		gap: 18px;
		align-content: start;
	}

	.principle-line {
		color: var(--ds-ink);
		font-family: var(--ds-font-display);
		font-size: clamp(2rem, 4.5vw, 4.9rem);
		font-weight: 700;
		line-height: 0.94;
	}

	.status-model,
	.component-list {
		display: grid;
		gap: 14px;
	}

	.status-model article,
	.component-list article {
		padding: 22px;
		border: 1px solid var(--ds-line);
		border-radius: var(--ds-radius-md);
		background: var(--ds-surface);
	}

	.status-model p {
		margin-top: 16px;
	}

	.swarm-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.swarm-grid article,
	.mission-card-grid article {
		min-height: 292px;
		padding: 24px;
		border: 1px solid var(--ds-line);
		border-radius: var(--ds-radius-md);
		background: var(--ds-surface);
		box-shadow: 0 18px 54px rgba(0, 0, 0, 0.2);
	}

	.swarm-grid h3,
	.mission-card-grid h3 {
		margin-top: 34px;
		font-size: clamp(1.45rem, 2.6vw, 2.3rem);
		line-height: 1.04;
	}

	.swarm-grid p {
		margin-top: 16px;
	}

	.flow-list {
		counter-reset: flow-step;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0;
		padding: 0;
		margin: 0;
		list-style: none;
		border: 1px solid var(--ds-line-strong);
		border-radius: var(--ds-radius-md);
		background: rgba(16, 13, 11, 0.36);
	}

	.flow-list li {
		counter-increment: flow-step;
		position: relative;
		display: grid;
		align-content: space-between;
		min-height: 248px;
		padding: 20px;
		border-right: 1px solid var(--ds-line);
	}

	.flow-list li:last-child {
		border-right: 0;
	}

	.flow-list li:not(:last-child)::after {
		position: absolute;
		top: 50%;
		right: -9px;
		z-index: 2;
		width: 18px;
		height: 18px;
		content: "";
		border-top: 1px solid var(--ds-blue);
		border-right: 1px solid var(--ds-blue);
		background: var(--ds-void);
		transform: translateY(-50%) rotate(45deg);
	}

	.flow-list li::before {
		color: var(--ds-blue);
		font-family: var(--ds-font-mono);
		font-size: 0.7rem;
		content: "0" counter(flow-step);
	}

	.flow-list span {
		font-family: var(--ds-font-display);
		font-size: clamp(1.12rem, 1.7vw, 1.5rem);
		font-weight: 700;
		line-height: 1.05;
	}

	.flow-list p {
		margin: 18px 0 0;
		color: var(--ds-ink-soft);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.components-grid {
		grid-template-columns: minmax(0, 0.95fr) minmax(320px, 1fr);
		align-items: stretch;
	}

	.component-list h3 {
		margin-top: 22px;
