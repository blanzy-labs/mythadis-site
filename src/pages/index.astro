---
import { brand, firstCase } from "../config/brand";
import SocialLinks from "../components/final-frontier/SocialLinks.astro";
import { launchReady } from "../config/launch";
import FinalFrontierLayout from "../layouts/FinalFrontierLayout.astro";
import BSMeter from "../components/final-frontier/BSMeter.astro";
import CaseVideo from "../components/final-frontier/CaseVideo.astro";
import EpisodeCard from "../components/final-frontier/EpisodeCard.astro";
import { getFeaturedCase, getLatestCases, caseHref, caseNumber } from "../lib/cases";
const featured = await getFeaturedCase();
const latest = await getLatestCases(4);
---
<FinalFrontierLayout title={`${brand.seriesProse} | Mythadis`}>

    <section class="hero" id="watch">
      <div class="hero-copy">
        <div class="hero-kicker">{brand.name} PRESENTS</div>
        <h1 aria-label={brand.series}>THE<br><span class="internet-word">INTERNET</span><br>SAID <em>WHAT?</em></h1>
        <div class="episode-no">CASE {caseNumber(featured.data.case)}</div>
        <div class="episode-title">{featured.id === firstCase.id ? firstCase.shortTitle : featured.data.title}</div>
        <a class="primary-cta" href={caseHref(featured)}><span aria-hidden="true">▶</span> WATCH THE INVESTIGATION →</a>
      </div>

      <div class="media-stage">

        <aside class="side-slogan">SAME<br>CLAIMS.<br>REAL<br>TESTS.<br>DIFFERENT<br>RESULTS.</aside>

        <CaseVideo youtubeId={featured.data.youtube_id} rumbleUrl={featured.data.rumble_url} title={featured.data.title} caseId={featured.data.case} thumbnail={featured.data.thumbnail} variant="home" />

        <BSMeter score={featured.data.preliminary_bs} verdict={featured.data.verdict} />

        <div class="badge"><span>MYTHADIS</span></div>
        <div class="small-slogan">A MORE<br>SKEPTICAL<br>TOMORROW.</div>
      </div>
    </section>

    <section class="latest" id="cases">
      <div class="latest-title">
        <h2>{launchReady ? "Latest Cases" : "DEV FIXTURES"}</h2>
        <a href="/watch/">VIEW ALL →</a>
      </div>
      <div class="episode-strip">
        {latest.map((entry, index) => <EpisodeCard entry={entry} index={index} />)}
      </div>
    </section>

    <section class="bottom-grid" id="submit" aria-label="Submit, follow and manifesto">
      <div class="submit-block">
        <div class="globe" aria-hidden="true"></div>
        <div class="submit-copy">
          <b>SEEN A SUSPICIOUS CLAIM?</b>
          <span>SEND IT TO THE LAB.</span>
        </div>
        <a class="submit-btn" href="/submit/">SUBMIT A CLAIM →</a>
      </div>
      <div class="follow">
        <b>FOLLOW MYTHADIS</b>
        <SocialLinks variant="follow" />
      </div>
      <div class="manifesto" aria-label={brand.tagline}>INTERNET<br>CLAIMS.<br>ACTUAL<br>EXPERIMENTS.</div>
    </section>

    <section class="evidence-band" id="evidence">
      <div class="evidence-left">
        <h2>SHOW<br>THE<br>RECEIPTS.</h2>
        <p>Every investigation publishes the claim, the test, what happened, and the evidence behind the verdict.</p>
      </div>
      <div class="evidence-right">
        <article class="receipt">
          <small>CASE {caseNumber(featured.data.case)} / EVIDENCE FILE</small>
          <h3><a href={caseHref(featured) + "#the-receipts"}>{featured.data.title}</a></h3>
          <p>{featured.data.summary}</p>
          <div class="stamp-row">
            <span class="stamp">{launchReady ? "THE CLAIM" : "EXAMPLE CLAIM"}</span>
            <span class="stamp">{launchReady ? "CASE FILE" : "MOCK CASE"}</span>
          </div>
        </article>
        <article class="receipt">
          <small>FINAL DISPOSITION</small>
          <h3>{featured.data.verdict ?? "Final verdict pending"}</h3>
          <p>{featured.data.final_bs !== undefined ? `Final BS: ${featured.data.final_bs}/10. ` : ""}{launchReady ? "Read the investigation notes and receipts on the case page." : "Example investigation: read the mock notes and receipts on the case page."}</p>
          <div class="stamp-row">
            <span class="stamp"><a href={caseHref(featured) + "#the-receipts"}>OPEN EVIDENCE FILE →</a></span>
          </div>
        </article>
      </div>
    </section>
</FinalFrontierLayout>
