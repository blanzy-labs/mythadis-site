---
interface Props { score: number; verdict?: string; label?: string; }
const { score, verdict, label = "BS METER" } = Astro.props;
---
<div class="bs-card" aria-label={`${label}: ${score} out of 10${verdict ? ` — ${verdict}` : ""}`}>
  <small>{label}</small>
  <div class="bs-score">{score}<span>/10</span></div>
  {verdict && <div class="bs-verdict">{verdict.toUpperCase()}</div>}
</div>
