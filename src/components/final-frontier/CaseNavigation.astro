---
import { caseIdentity, caseHref, type CaseEntry } from "../../lib/cases";
interface Props { previous?: CaseEntry; next?: CaseEntry; }
const { previous, next } = Astro.props;
---
{(previous || next) && <nav class="investigation-navigation" aria-label="Adjacent published cases">
  {previous && <a class="case-previous" href={caseHref(previous)}><span>← PREVIOUS / {caseIdentity(previous)}</span><b>{previous.data.title}</b></a>}
  {next && <a class="case-next" href={caseHref(next)}><span>NEXT / {caseIdentity(next)} →</span><b>{next.data.title}</b></a>}
</nav>}
