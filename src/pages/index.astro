---
import { brand } from "../config/brand";
import SocialLinks from "../components/final-frontier/SocialLinks.astro";
import FinalFrontierLayout from "../layouts/FinalFrontierLayout.astro";
import CaseVideo from "../components/final-frontier/CaseVideo.astro";
import FilmCard from "../components/final-frontier/FilmCard.astro";
import { films } from "../data/films";
import { publishedFilms, filmHref } from "../lib/films";
const productions = publishedFilms(films);
const featured = productions[0];
---
<FinalFrontierLayout>

    <section class="hero" id="watch">
      <div class="hero-copy">
        <div class="hero-kicker">{brand.descriptor}</div>
        <h1 aria-label="AI video. Human imagination.">AI <span class="internet-word">VIDEO.</span><br>HUMAN<br><em>IMAGINATION.</em></h1>
        <div class="episode-no">{featured ? "NOW SHOWING" : "FIRST PRODUCTION IN PROGRESS"}</div>
        <div class="episode-title">{featured?.title ?? brand.tagline}</div>
        <p>Original short films, unusual worlds and animated stories created through AI tools and human imagination.</p>
        <a class="primary-cta" href={featured ? filmHref(featured) : "/watch/"}>{featured ? "WATCH OUR FILMS" : "EXPLORE PRODUCTIONS"} →</a>
      </div>

      <div class="media-stage">

        <aside class="side-slogan">FROM<br>STORY-<br>BOARD<br>TO<br>SCREEN.</aside>

        <CaseVideo youtubeId={featured?.youtubeId} title={featured?.title ?? "First production in progress"} thumbnail={featured?.thumbnail} variant="home" />

        <div class="bs-card" aria-label={featured ? "Now showing" : "In production"}>
          <small>MYTHADIS STUDIO</small>
          <div class="bs-score studio-status">{featured ? "ON AIR" : "IN PRODUCTION"}</div>
          <div class="bs-verdict">FROM STORYBOARD TO SCREEN</div>
        </div>

        <div class="badge"><span>MYTHADIS</span></div>
        <div class="small-slogan">IMAGINATION<br>WITHOUT<br>LIMITS.</div>
      </div>
    </section>

    <section class="latest" id="productions">
      <div class="latest-title">
        <h2>Productions</h2>
        <a href="/watch/">VIEW ALL →</a>
      </div>
      <div class="episode-strip">
        {productions.length ? productions.slice(0, 4).map(film => <FilmCard film={film} />) : <article class="episode-card ai empty-production"><small>IN PRODUCTION</small><h3>Our first original short film is in progress.</h3><p>Watch here when it is ready.</p></article>}
      </div>
    </section>

    <section class="bottom-grid" aria-label="Original filmmaking, follow and studio">
      <div class="submit-block">
        <div class="globe" aria-hidden="true"></div>
        <div class="submit-copy">
          <b>ORIGINAL AI FILMMAKING.</b>
          <span>HUMAN IDEAS. NEW WORLDS.</span>
        </div>
        <a class="submit-btn" href="/about/">ABOUT THE STUDIO →</a>
      </div>
      <div class="follow">
        <b>FOLLOW MYTHADIS</b>
        <SocialLinks variant="follow" />
      </div>
      <div class="manifesto" aria-label={brand.tagline}>IMAGINATION<br>WITHOUT<br>LIMITS.</div>
    </section>

    <section class="evidence-band" id="filmmaking">
      <div class="evidence-left">
        <h2>FROM IDEA<br>TO<br>SCREEN.</h2>
        <p>Original stories shaped by human ideas, artwork and creative direction, brought to the screen with emerging AI tools.</p>
      </div>
      <div class="evidence-right">
        <article class="receipt">
          <small>ORIGINAL PRODUCTIONS</small>
          <h3>{featured?.title ?? "First production in progress"}</h3>
          <p>{featured?.synopsis ?? "Our first original short film will appear here once it is finished and approved for release."}</p>
          <div class="stamp-row"><span class="stamp"><a href={featured ? filmHref(featured) : "/watch/"}>{featured ? "WATCH THE FILM" : "EXPLORE PRODUCTIONS"} →</a></span></div>
        </article>
        <article class="receipt">
          <small>HUMAN-DIRECTED AI</small>
          <h3>Unusual worlds. Original stories.</h3>
          <p>Mythadis Limited explores original storytelling through AI-assisted filmmaking.</p>
          <div class="stamp-row"><span class="stamp"><a href="/about/">ABOUT MYTHADIS →</a></span></div>
        </article>
      </div>
    </section>
</FinalFrontierLayout>

<style>
.hero h1 em{font-size:.55em}
.studio-status{font-size:38px;line-height:1;overflow-wrap:anywhere}
.episode-card p{position:relative}
.empty-production{grid-column:1/-1}
</style>
