---
interface Props {
	href?: string;
	variant?: "primary" | "secondary";
}

const { href, variant = "primary" } = Astro.props;
const Tag = href ? "a" : "button";
const rel = href?.startsWith("http") ? "noreferrer" : undefined;
---

<Tag
	class:list={["ds-button", `ds-button--${variant}`, "ds-hover-lift"]}
	href={href}
	rel={rel}
>
	<slot />
</Tag>

<style>
	.ds-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0 18px;
		border: 1px solid var(--ds-line-strong);
		border-radius: var(--ds-radius-sm);
		font-family: var(--ds-font-body);
		font-size: 0.92rem;
		font-weight: 700;
		transition:
			color 140ms ease,
			background 140ms ease,
			border-color 140ms ease,
			box-shadow 140ms ease,
			transform 140ms ease;
	}

	.ds-button--primary {
		border-color: var(--ds-blue);
		color: #1a100b;
		background: var(--ds-blue);
		box-shadow: 0 12px 28px rgba(255, 122, 53, 0.16);
	}

	.ds-button--secondary {
		color: var(--ds-ink);
		background: var(--ds-surface);
	}

	.ds-button--primary:hover {
		border-color: var(--ds-primary-hover);
		background: var(--ds-primary-hover);
	}

	.ds-button--secondary:hover {
		border-color: var(--ds-plum);
		background: var(--ds-selection-soft);
	}
</style>
