---
import { brand } from "../config/brand";
import FinalFrontierLayout from "../layouts/FinalFrontierLayout.astro";
---
<FinalFrontierLayout title="About Mythadis — AI Video Production Studio">
  <section class="route-heading">
    <span class="hero-kicker">{brand.descriptor}</span>
    <h1>IMAGINATION<br /><em>WITHOUT LIMITS.</em></h1>
    <p>Mythadis Limited is an Irish AI technology and creative production company exploring original storytelling through AI-assisted filmmaking. Our projects combine human ideas, artwork and creative direction with emerging video-generation tools.</p>
  </section>
  <section class="editorial-band">
    <div class="editorial-copy">
      <h2>AI VIDEO. HUMAN IMAGINATION.</h2>
      <p>We explore original short films, unusual worlds and animated stories. Human ideas and creative direction guide the work, from the first storyboard to the finished screen.</p>
      <h2>ORIGINAL WORK</h2>
      <p>Our focus is our own films and stories. The Internet Said What? is a possible future series, not the studio’s umbrella identity.</p>
    </div>
    <aside class="broadcast-panel">
      <h2>FROM STORYBOARD<br />TO SCREEN.</h2>
      <p>Finished films will be shared on YouTube, with their own permanent home on Mythadis.com for the story and creator credit.</p>
      <a class="primary-cta" href="/watch/">EXPLORE PRODUCTIONS →</a>
    </aside>
  </section>
</FinalFrontierLayout>
