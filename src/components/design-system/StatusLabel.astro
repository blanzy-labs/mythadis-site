---
interface Props {
	tone?: "blue" | "amber" | "green" | "plum";
}

const { tone = "blue" } = Astro.props;
---

<span class:list={["ds-status-label", `ds-status-label--${tone}`]}>
	<slot />
</span>

<style>
	.ds-status-label {
		display: inline-flex;
		padding: 7px 9px;
		border: 1px solid rgba(170, 169, 223, 0.36);
		border-radius: var(--ds-radius-sm);
		color: var(--ds-info);
		background: rgba(170, 169, 223, 0.09);
		font-family: var(--ds-font-mono);
		font-size: 0.64rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.ds-status-label--amber {
		border-color: rgba(240, 183, 95, 0.36);
		color: var(--ds-amber);
		background: rgba(240, 183, 95, 0.09);
	}

	.ds-status-label--green {
		border-color: rgba(111, 204, 162, 0.38);
		color: var(--ds-mint);
		background: rgba(111, 204, 162, 0.09);
	}

	.ds-status-label--plum {
		border-color: rgba(168, 101, 181, 0.4);
		color: var(--ds-plum-text);
		background: var(--ds-selection-soft);
	}
</style>
