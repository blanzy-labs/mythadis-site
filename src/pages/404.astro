---
import FinalFrontierLayout from "../layouts/FinalFrontierLayout.astro";
---
<FinalFrontierLayout title="404 — Signal Not Found | Mythadis" description="That Mythadis page could not be found. Return to the investigations or send a claim to the lab." noindex canonicalPath={null}>
  <section class="route-heading not-found">
    <span class="hero-kicker">404 / SIGNAL NOT FOUND</span>
    <h1>NOTHING<br /><em>ON THIS CHANNEL.</em></h1>
    <p>This address may have changed. Pick up the trail from the lab.</p>
    <nav aria-label="Find your way back"><a href="/">HOME →</a><a href="/watch/">WATCH →</a><a href="/cases/">CASE FILES →</a><a href="/submit/">SUBMIT A CLAIM →</a></nav>
  </section>
</FinalFrontierLayout>
<style>
  .not-found{min-height:55vh}.not-found nav{display:flex;flex-wrap:wrap;gap:18px 28px;margin:30px 0}.not-found nav a{font:900 13px/1.5 Arial;padding:12px 0;text-underline-offset:5px}
</style>
