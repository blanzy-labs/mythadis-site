---
import { filmHref, type Film } from "../../lib/films";
interface Props { film: Film; }
const { film } = Astro.props;
---
<article class="episode-card ai">
  {<img class="episode-thumbnail" src={film.thumbnail ?? "/images/films/off-air.svg"} alt="" loading="lazy" />}
  <small>ORIGINAL FILM</small>
  <h3><a href={filmHref(film)}>{film.title}</a></h3>
  <div class="score">NOW SHOWING</div>
</article>
