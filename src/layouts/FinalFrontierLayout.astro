---
import Header from "../components/final-frontier/Header.astro";
import Footer from "../components/final-frontier/Footer.astro";
import { productionOrigin } from "../data/site";
import { launchReady, siteMetadata } from "../config/launch";
import "../styles/analog-future.css";
interface Props { title?: string; description?: string; canonicalPath?: string | null; socialImage?: string; ogType?: "website" | "article"; noindex?: boolean; }
const { title = siteMetadata.title, description = siteMetadata.description, canonicalPath = Astro.url.pathname, socialImage, ogType = "website", noindex = false } = Astro.props;
const canonical = canonicalPath ? new URL(canonicalPath, productionOrigin) : undefined;
const image = socialImage?.startsWith("/") && !socialImage.startsWith("//") ? new URL(socialImage, productionOrigin) : undefined;
const previewBuild = import.meta.env.CF_PAGES === "1" && import.meta.env.CF_PAGES_BRANCH !== "main";
const preventIndexing = noindex || !launchReady || previewBuild;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <meta property="og:site_name" content="Mythadis" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {image && <meta property="og:image" content={image.href} />}
    {preventIndexing && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <Header />
      <main id="main"><slot /></main>
      <Footer />
    </div>
  </body>
</html>
