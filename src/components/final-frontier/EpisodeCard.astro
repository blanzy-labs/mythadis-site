---
import { caseHref, caseNumber, caseIdentity, type CaseEntry } from "../../lib/cases";
interface Props { entry: CaseEntry; index: number; }
const { entry, index } = Astro.props;
const treatment = ["ai", "game", "stock", "crypto"][index % 4];
---
<article class:list={["episode-card", treatment]}>
  {entry.data.thumbnail && <img class="episode-thumbnail" src={entry.data.thumbnail} alt="" loading="lazy" />}
  <span class="ep" aria-label={caseIdentity(entry)}>{caseNumber(entry.data.case)}</span>
  <small>{caseIdentity(entry)}</small>
  <h3><a href={caseHref(entry)}>{entry.data.title}</a></h3>
  <div class="score">BS {entry.data.preliminary_bs}</div>
</article>
