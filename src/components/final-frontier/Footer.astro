---
import { brand } from "../../config/brand";
import { editorialStandardsHref } from "../../config/editorial";
interface Props { archive?: boolean; }
const { archive = false } = Astro.props;
---

  <footer class="site-footer" id="about">
    <span>{brand.name} / {brand.descriptor}</span>
    <span>{brand.tagline}</span>
    {archive && <p class="footer-editorial">BS Meter ratings are Mythadis editorial opinions based on the evidence available at publication. <a href={editorialStandardsHref}>Editorial Standards</a></p>}
  </footer>

<style>
.site-footer{flex-wrap:wrap;gap:12px 24px}
.footer-editorial{flex-basis:100%;margin:0;max-width:85ch;font-weight:400;line-height:1.6}
.footer-editorial a{font-weight:900;text-underline-offset:3px}
</style>
