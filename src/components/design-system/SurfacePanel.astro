---
interface Props {
	variant?: "default" | "strong" | "warning";
}

const { variant = "default" } = Astro.props;
---

<div class:list={["ds-surface-panel", `ds-surface-panel--${variant}`]}>
	<slot />
</div>

<style>
	.ds-surface-panel {
		border: 1px solid var(--ds-line);
		border-radius: var(--ds-radius-md);
		background: var(--ds-surface);
		box-shadow: 0 18px 54px rgba(0, 0, 0, 0.18);
		overflow: hidden;
	}

	.ds-surface-panel--strong {
		background:
			linear-gradient(135deg, rgba(255, 122, 53, 0.055), transparent 42%),
			var(--ds-surface-strong);
	}

	.ds-surface-panel--warning {
		border-color: rgba(240, 183, 95, 0.28);
		background: linear-gradient(120deg, rgba(240, 183, 95, 0.075), var(--ds-surface));
	}
</style>
